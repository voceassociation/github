{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "LEGIS_DB",
      "database_name": "voce-legis-beta",
      "database_id": "62db925a-8b3a-40c1-9936-1ef63fb95bf1",
      "migrations_dir": "migrations/legis"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VOCE_CORPUS",
      "bucket_name": "voce-sovereign-corpus"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "previews": {}
}
